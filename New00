Private Sub LoadRecordFromLocal(ws As Worksheet, localRow As Long, targetRow As Long)
    ws.Unprotect
    
    ' Load common fields if not already loaded
    If ws.Range("C6").value = "" Then ws.Range("C6").value = ws.Cells(localRow, 7).value ' Month
    If ws.Range("E6").value = "" Then ws.Range("E6").value = ws.Cells(localRow, 8).value ' Week
    If ws.Range("H6").value = "" Then ws.Range("H6").value = ws.Cells(localRow, 12).value ' Team Name
    
    ' Load row-specific data
    ws.Cells(targetRow, 2).value = ws.Cells(localRow, 9).value ' Region
    ws.Cells(targetRow, 3).value = ws.Cells(localRow, 10).value ' Engagement ID
    ws.Cells(targetRow, 5).value = ws.Cells(localRow, 11).value ' Engagement Hours
    ws.Cells(targetRow, 6).value = ws.Cells(localRow, 13).value ' Audit Remark 1
    ws.Cells(targetRow, 8).value = ws.Cells(localRow, 14).value ' Non-Audit Eng Name
    ws.Cells(targetRow, 9).value = ws.Cells(localRow, 15).value ' Non-Audit Hours
    ws.Cells(targetRow, 10).value = ws.Cells(localRow, 16).value ' Non-Audit Remark 2
    
    ' Load Engagement Activity if available (old records won't have this)
    If ws.Cells(localRow, 17).value <> "" Then
        ws.Cells(targetRow, 4).value = ws.Cells(localRow, 17).value
    End If
    
    ws.Protect UserInterfaceOnly:=True
End Sub

Private Sub LoadRecordFromDatabase(ws As Worksheet, wsDB As Worksheet, dbRow As Long, targetRow As Long)
    ws.Unprotect
    
    ' Load common fields if not already loaded
    If ws.Range("C6").value = "" Then ws.Range("C6").value = wsDB.Cells(dbRow, 7).value ' Month
    If ws.Range("E6").value = "" Then ws.Range("E6").value = wsDB.Cells(dbRow, 8).value ' Week
    If ws.Range("H6").value = "" Then ws.Range("H6").value = wsDB.Cells(dbRow, 12).value ' Team Name
    
    ' Load row-specific data
    ws.Cells(targetRow, 2).value = wsDB.Cells(dbRow, 9).value ' Region
    ws.Cells(targetRow, 3).value = wsDB.Cells(dbRow, 10).value ' Engagement ID
    ws.Cells(targetRow, 5).value = wsDB.Cells(dbRow, 11).value ' Engagement Hours
    ws.Cells(targetRow, 6).value = wsDB.Cells(dbRow, 13).value ' Audit Remark 1
    ws.Cells(targetRow, 8).value = wsDB.Cells(dbRow, 14).value ' Non-Audit Eng Name
