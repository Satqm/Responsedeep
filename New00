Public Sub StartCorrection()
    Dim ws As Worksheet
    Dim uniqueCode As String
    Dim foundRows As Collection
    Dim i As Long, rowIndex As Long
    
    Set ws = ActiveSheet
    
    ' Get unique code from user
    uniqueCode = InputBox("Enter Unique Code to correct:", "Timesheet Correction")
    If uniqueCode = "" Then
        MsgBox "Correction cancelled.", vbInformation
        Exit Sub
    End If
    
    ' Set correction mode
    ws.Unprotect
    ws.Range("BA2").value = "Timesheet Entry Correction"
    ws.Range("AT1").value = uniqueCode ' Store unique code in hidden cell
    ws.Protect UserInterfaceOnly:=True
    
    ' Search for records with this unique code
    Set foundRows = New Collection
    
    ' Search in local storage (rows 3000+)
    Dim lastLocalRow As Long
    lastLocalRow = ws.Cells(ws.Rows.count, "B").End(xlUp).Row
    If lastLocalRow >= 3000 Then
        For i = 3000 To lastLocalRow
            If ws.Cells(i, 2).value = uniqueCode And ws.Cells(i, 3).value = ws.Range("W6").value Then
                foundRows.Add i
            End If
        Next i
    End If
    
    ' Search in database
    Dim wsDB As Worksheet
    Set wsDB = ThisWorkbook.Sheets("TimesheetData")
    Dim lastDBRow As Long
    lastDBRow = wsDB.Cells(wsDB.Rows.count, 1).End(xlUp).Row
    If lastDBRow >= 2 Then
        For i = 2 To lastDBRow
            If wsDB.Cells(i, 1).value = uniqueCode And wsDB.Cells(i, 2).value = ws.Range("W6").value Then
                foundRows.Add i & "|DB" ' Mark as database row
            End If
        Next i
    End If
    
    ' Clear form before loading
    ClearFormInputs ws
    
    ' Load found records into form
    Dim recordCount As Long
    recordCount = 0
    
    For i = 1 To foundRows.count
        If i <= 5 Then ' Max 5 rows
            Dim sourceRow As Variant
            sourceRow = foundRows(i)
            
            If InStr(sourceRow, "|DB") > 0 Then
                ' Load from database
                Dim dbRow As Long
                dbRow = CLng(Split(sourceRow, "|")(0))
                LoadRecordFromDatabase ws, wsDB, dbRow, i + 9
                recordCount = recordCount + 1
            Else
                ' Load from local storage
                LoadRecordFromLocal ws, sourceRow, i + 9
                recordCount = recordCount + 1
            End If
        End If
    Next i
    
    If recordCount > 0 Then
        MsgBox recordCount & " record(s) loaded for correction." & vbNewLine & _
               "Unique Code: " & uniqueCode & vbNewLine & _
               "Make your changes and click Submit.", vbInformation, "Correction Mode"
    Else
        MsgBox "No records found for Unique Code: " & uniqueCode, vbExclamation, "Record Not Found"
        ws.Unprotect
        ws.Range("BA2").value = "New Timesheet Entry"
        ws.Range("AT1").ClearContents
        ws.Protect UserInterfaceOnly:=True
    End If
End Sub

