' ========== ADMIN SYNC ==========
Public Sub SyncAllToDatabase()
    On Error GoTo ErrorHandler
    
    Dim pass As String
    pass = InputBox("Enter sync password:", "Admin Sync Required")
    If pass <> "123" Then
        MsgBox "Incorrect password. Access denied.", vbCritical, "Access Denied"
        Exit Sub
    End If
    
    Dim ws As Worksheet, wsDB As Worksheet, wsTSData As Worksheet, wsAdmin As Worksheet
    Dim r As Long, lastLocalRow As Long, nextDBRow As Long
    Dim recordCount As Long, userCount As Long, deletedCount As Long
    
    Set wsDB = ThisWorkbook.Sheets("Data base")
    Set wsTSData = ThisWorkbook.Sheets("TimesheetData")
    Set wsAdmin = ThisWorkbook.Sheets("Admin")
    
    wsDB.Unprotect
    wsTSData.Unprotect
    
    ' Process deletions in TimesheetData
    Dim lastTSRow As Long
    lastTSRow = wsTSData.Cells(wsTSData.Rows.count, 1).End(xlUp).Row
    For r = lastTSRow To 2 Step -1
        If wsTSData.Cells(r, 18).value = "Marked for Deletion" Then
            wsTSData.Rows(r).Delete
            deletedCount = deletedCount + 1
        End If
    Next r
    
    ' Process each user sheet
    recordCount = 0
    userCount = 0
    
    For Each ws In ThisWorkbook.Sheets
        If ws.Name <> "Data base" And ws.Name <> "Login" And ws.Name <> "TimesheetData" And ws.Name <> "Admin" Then
            lastLocalRow = ws.Cells(ws.Rows.count, "B").End(xlUp).Row
            If lastLocalRow >= 3000 Then
                Dim userRecords As Long: userRecords = 0
                For r = 3000 To lastLocalRow
                    If ws.Cells(r, 2).value <> "" Then
                        If ws.Cells(r, 19).value <> "Marked for Deletion" Then ' Column S
                            ' Copy to main database
                            nextDBRow = wsDB.Cells(wsDB.Rows.count, 1).End(xlUp).Row + 1
                            wsDB.Cells(nextDBRow, 1).Resize(1, 17).value = ws.Range(ws.Cells(r, 2), ws.Cells(r, 18)).value
                            
                            ' Copy to TimesheetData (already done on submit, but sync local pending)
                            nextTSRow = wsTSData.Cells(wsTSData.Rows.count, 1).End(xlUp).Row + 1
                            wsTSData.Cells(nextTSRow, 1).Resize(1, 17).value = ws.Range(ws.Cells(r, 2), ws.Cells(r, 18)).value
                            
                            recordCount = recordCount + 1
                            userRecords = userRecords + 1
                        Else
                            deletedCount = deletedCount + 1
                        End If
                    End If
                Next r
                
                If userRecords > 0 Or deletedCount > 0 Then
                    ' Clear local storage after successful sync
                    On Error Resume Next
                    ws.Unprotect
                    ws.Range("B3000:S" & lastLocalRow).ClearContents
                    ws.Protect UserInterfaceOnly:=True
                    On Error GoTo 0
                    userCount = userCount + 1
                End If
            End If
        End If
    Next ws
    
    wsDB.Protect UserInterfaceOnly:=True
    wsTSData.Protect UserInterfaceOnly:=True
    
    ' Update sync timestamp
    wsAdmin.Range("G5").value = Format(Now, "yyyy-mm-dd hh:mm:ss")
    
    ' Save workbook
    ThisWorkbook.Save
    
    MsgBox "SYNC COMPLETED!" & vbCrLf & _
           "Users processed: " & userCount & vbCrLf & _
           "Records synced: " & recordCount & vbCrLf & _
           "Records deleted: " & deletedCount & vbCrLf & _
           "Last sync: " & Format(Now, "yyyy-mm-dd hh:mm:ss"), vbInformation, "Sync Complete"
    
    Call UpdatePendingCounts
    Call LogoutAllUserSheets
    Exit Sub
    
ErrorHandler:
    MsgBox "An error occurred: " & Err.Description, vbCritical, "Error"
    On Error Resume Next
    wsDB.Protect UserInterfaceOnly:=True
    wsTSData.Protect UserInterfaceOnly:=True
    ThisWorkbook.Save
End Sub

