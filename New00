' ========== SUBMIT TIMESHEET (MULTI-ROW VERSION) ==========
Public Sub SubmitTimesheet()
    On Error GoTo ErrorHandler
    
    Dim wsForm As Worksheet, wsDB As Worksheet, wsTSData As Worksheet
    Dim nextRow As Long, i As Long
    Dim timesheetType As String, enterpriseID As String, uniqueCode As String
    Dim employeeName As String, employeeEmail As String, monthName As String, weekName As String, teamName As String
    Dim recordCount As Long
    Dim isCorrection As Boolean
    Dim records As Collection
    Dim record As Dictionary
    
    Set wsForm = ActiveSheet
    Set wsDB = ThisWorkbook.Sheets("Data base")
    Set wsTSData = ThisWorkbook.Sheets("TimesheetData")
    
    ' Gather fixed form values
    enterpriseID = Trim(wsForm.Range("W6").value)
    employeeName = Trim(wsForm.Range("F2").value)
    employeeEmail = Trim(wsForm.Range("W7").value)
    timesheetType = Trim(wsForm.Range("BA2").value)
    monthName = Trim(wsForm.Range("C6").value)
    weekName = Trim(wsForm.Range("E6").value)
    teamName = Trim(wsForm.Range("H6").value)
    
    ' Check if this is a correction
    isCorrection = (LCase(timesheetType) = "timesheet entry correction")
    
    ' Validations
    If Not ValidateRequiredFields(wsForm, enterpriseID, monthName, weekName, teamName) Then GoTo CleanUp
    If Not ValidateEngagementRows(wsForm) Then GoTo CleanUp
    
    ' Collect data from rows 10-14
    Set records = CollectFormData(wsForm, enterpriseID, employeeName, employeeEmail, _
                                  timesheetType, monthName, weekName, teamName)
    recordCount = records.count
    
    If recordCount = 0 Then
        MsgBox "No valid engagement data found. Please fill at least one engagement row.", vbExclamation
        GoTo CleanUp
    End If
    
    ' Get unique code
    If isCorrection Then
        uniqueCode = Trim(wsForm.Range("AT1").value)
        If uniqueCode = "" Then
            MsgBox "Unique code missing for correction.", vbExclamation
            GoTo CleanUp
        End If
        
        ' Mark previous records for deletion
        MarkRecordsForDeletion wsForm, uniqueCode, enterpriseID
        MarkDBRecordsForDeletion wsTSData, uniqueCode, enterpriseID
    Else
        uniqueCode = GetNextUniqueCode(wsForm, wsTSData, enterpriseID)
        
        ' Check for duplicates
        If CheckForDuplicates(wsForm, wsTSData, records, enterpriseID, monthName, weekName, teamName) Then
            GoTo CleanUp
        End If
    End If
    
    ' Confirmation
    If MsgBox("Submit " & recordCount & " engagement record(s)?" & vbCrLf & _
              "Unique Code: " & uniqueCode & vbCrLf & _
              "Type: " & timesheetType, vbQuestion + vbYesNo, "Confirm Submission") = vbNo Then
        MsgBox "Submission cancelled.", vbInformation
        GoTo CleanUp
    End If
    
    Application.EnableEvents = False
    Application.ScreenUpdating = False
    
    ' Write to TimesheetData
    For i = 1 To recordCount
        Set record = records(i)
        record("Unique Code") = uniqueCode
        WriteToTimesheetData wsTSData, record
    Next i
    
    ' Write to local storage (backup)
    WriteToLocalStorage wsForm, records, uniqueCode
    
    ' Auto-save
    ThisWorkbook.Save
    
    ' Success message
    MsgBox "SUCCESS! " & IIf(isCorrection, "CORRECTION", "NEW ENTRY") & " submitted!" & vbCrLf & _
           "Unique Code: " & uniqueCode & vbCrLf & _
           "Records: " & recordCount & vbCrLf & _
           "Will be synced to main database by Admin.", vbInformation, "Submission Complete"
    
    ' Reset form
    ResetFormInputsOnly wsForm
    
    GoTo CleanUp
    
ErrorHandler:
    MsgBox "ERROR in SubmitTimesheet:" & vbCrLf & _
           "Error: " & Err.Description & vbCrLf & _
           "Number: " & Err.Number, vbCritical, "System Error"
    
CleanUp:
    On Error Resume Next
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    Call UpdatePendingCounts
End Sub

