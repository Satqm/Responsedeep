Private Sub Worksheet_Change(ByVal Target As Range)
    Static isProcessing As Boolean
    If isProcessing Then Exit Sub
    
    isProcessing = True
    Application.EnableEvents = False
    
    ' Region changed: clear corresponding Engagement ID
    If Not Intersect(Target, Me.Range("B10:B14")) Is Nothing Then
        Dim rng As Range
        For Each rng In Target
            If rng.Row >= 10 And rng.Row <= 14 Then
                If Me.Cells(rng.Row, 3).value <> "" Then ' Column C (Engagement Name)
                    Me.Unprotect
                    Me.Cells(rng.Row, 3).ClearContents
                    Me.Protect UserInterfaceOnly:=True
                End If
            End If
        Next rng
    End If
    
    ' Engagement Name requires Region
    If Not Intersect(Target, Me.Range("C10:C14")) Is Nothing Then
        Dim cell As Range
        For Each cell In Target
            If cell.Row >= 10 And cell.Row <= 14 Then
                If Me.Cells(cell.Row, 2).value = "" Then ' Column B (Region)
                    MsgBox "Please select Region first for row " & cell.Row - 9 & ".", vbExclamation, "Region Required"
                    Me.Unprotect
                    cell.ClearContents
                    Me.Protect UserInterfaceOnly:=True
                    Me.Cells(cell.Row, 2).Select
                    GoTo CleanUp
                End If
            End If
        Next cell
    End If
    
    ' Clear corresponding Non-Audit fields when Audit fields are filled
    If Not Intersect(Target, Me.Range("C10:C14,E10:E14")) Is Nothing Then
        For Each cell In Target
            If cell.Row >= 10 And cell.Row <= 14 Then
                If cell.Column = 3 Or cell.Column = 5 Then ' Column C or E
                    If cell.value <> "" Then
                        If Me.Cells(cell.Row, 8).value <> "" Or Me.Cells(cell.Row, 9).value <> "" Then
                            Me.Unprotect
                            Me.Cells(cell.Row, 8).ClearContents ' Column H
                            Me.Cells(cell.Row, 9).ClearContents ' Column I
                            Me.Protect UserInterfaceOnly:=True
                        End If
                    End If
                End If
            End If
        Next cell
    End If
    
    ' Clear corresponding Audit fields when Non-Audit fields are filled
    If Not Intersect(Target, Me.Range("H10:H14,I10:I14")) Is Nothing Then
        For Each cell In Target
            If cell.Row >= 10 And cell.Row <= 14 Then
                If cell.Column = 8 Or cell.Column = 9 Then ' Column H or I
                    If cell.value <> "" Then
                        If Me.Cells(cell.Row, 3).value <> "" Or Me.Cells(cell.Row, 5).value <> "" Then
                            Me.Unprotect
                            Me.Cells(cell.Row, 3).ClearContents ' Column C
                            Me.Cells(cell.Row, 5).ClearContents ' Column E
                            Me.Protect UserInterfaceOnly:=True
                        End If
                    End If
                End If
            End If
        Next cell
    End If
    
CleanUp:
    Application.EnableEvents = True
    isProcessing = False
End Sub

