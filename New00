Private Function ValidateEngagementRows(ws As Worksheet) As Boolean
    Dim i As Long
    Dim auditFilled As Boolean, nonAuditFilled As Boolean
    
    ValidateEngagementRows = True
    
    For i = 10 To 14
        auditFilled = (Len(Trim(ws.Cells(i, 3).value)) > 0 And Len(Trim(ws.Cells(i, 5).value)) > 0)
        nonAuditFilled = (Len(Trim(ws.Cells(i, 8).value)) > 0 And Len(Trim(ws.Cells(i, 9).value)) > 0)
        
        ' Check for partial audit fill
        If (Len(Trim(ws.Cells(i, 3).value)) > 0 Xor Len(Trim(ws.Cells(i, 5).value)) > 0) Then
            MsgBox "Row " & i - 9 & ": Please fill both Engagement Name and Hours for Audit.", vbExclamation
            ValidateEngagementRows = False
            Exit Function
        End If
        
        ' Check for partial non-audit fill
        If (Len(Trim(ws.Cells(i, 8).value)) > 0 Xor Len(Trim(ws.Cells(i, 9).value)) > 0) Then
            MsgBox "Row " & i - 9 & ": Please fill both Non-Audit Engagement and Hours.", vbExclamation
            ValidateEngagementRows = False
            Exit Function
        End If
        
        ' Check if both audit and non-audit are filled in same row
        If auditFilled And nonAuditFilled Then
            MsgBox "Row " & i - 9 & ": Please fill either Audit OR Non-Audit, not both in the same row.", vbExclamation
            ValidateEngagementRows = False
            Exit Function
        End If
    Next i
End Function

' ========== UNIQUE CODE GENERATION ==========
Private Function GetNextUniqueCode(wsForm As Worksheet, wsTSData As Worksheet, entID As String) As String
    Dim maxCodeLocal As Long, maxCodeDB As Long
    Dim r As Long, lastRow As Long
    
    ' Check local storage
    maxCodeLocal = 0
    lastRow = wsForm.Cells(wsForm.Rows.count, "B").End(xlUp).Row
    For r = 3000 To lastRow
        If wsForm.Cells(r, 3).value = entID Then
            If IsNumeric(wsForm.Cells(r, 2).value) And wsForm.Cells(r, 2).value > maxCodeLocal Then
                maxCodeLocal = wsForm.Cells(r, 2).value
            End If
        End If
    Next r
    
    ' Check TimesheetData
    maxCodeDB = 0
    lastRow = wsTSData.Cells(wsTSData.Rows.count, 1).End(xlUp).Row
    For r = 2 To lastRow
        If wsTSData.Cells(r, 2).value = entID Then
            If IsNumeric(wsTSData.Cells(r, 1).value) And wsTSData.Cells(r, 1).value > maxCodeDB Then
                maxCodeDB = wsTSData.Cells(r, 1).value
            End If
        End If
    Next r
    
    GetNextUniqueCode = CStr(Application.Max(maxCodeLocal, maxCodeDB) + 1)
End Function

' ========== DUPLICATE CHECKING ==========
Private Function CheckForDuplicates(wsForm As Worksheet, wsTSData As Worksheet, records As Collection, _
                                    entID As String, monthName As String, weekName As String, teamName As String) As Boolean
    Dim i As Long
    Dim record As Dictionary
    
    For i = 1 To records.count
        Set record = records(i)
        
        ' Only check audit engagements for duplicates
        If record("Engagement ID") <> "" Then
            If FindDuplicateLocal(wsForm, entID, record("Engagement ID"), monthName, weekName, _
                                  record("Region"), teamName) > 0 Or _
               FindDuplicateDB(wsTSData, entID, record("Engagement ID"), monthName, weekName, _
                              record("Region"), teamName) > 0 Then
                
                Dim response As VbMsgBoxResult
                response = MsgBox("This engagement already exists for " & monthName & " - " & weekName & _
                                  ". Do you want to make a correction instead?", vbYesNo + vbExclamation, "Duplicate Entry")
                
                If response = vbYes Then
                    ' Switch to correction mode
                    wsForm.Unprotect
                    wsForm.Range("BA2").value = "Timesheet Entry Correction"
                    
                    ' Find and suggest unique code
                    Dim dupCode As String
                    dupCode = FindDuplicateCode(wsForm, wsTSData, entID, record("Engagement ID"), _
                                                monthName, weekName, record("Region"), teamName)
                    If dupCode <> "" Then
                        wsForm.Range("AT1").value = dupCode
                        MsgBox "Please proceed with correction using code: " & dupCode, vbInformation, "Correction Mode"
                    End If
                    
                    wsForm.Protect UserInterfaceOnly:=True
                End If
                
                CheckForDuplicates = True
                Exit Function
            End If
        End If
    Next i
    
    CheckForDuplicates = False
End Function

Private Function FindDuplicateLocal(ws As Worksheet, entID As String, engID As String, _
                                    monthName As String, weekName As String, regionName As String, teamName As String) As Long
    Dim r As Long, lastRow As Long
    lastRow = ws.Cells(ws.Rows.count, "B").End(xlUp).Row
    
    For r = 3000 To lastRow
        If ws.Cells(r, 3).value = entID And _
           ws.Cells(r, 10).value = engID And _
           ws.Cells(r, 7).value = monthName And _
           ws.Cells(r, 8).value = weekName And _
           ws.Cells(r, 9).value = regionName And _
           ws.Cells(r, 12).value = teamName And _
           LCase(ws.Cells(r, 6).value) = "new timesheet entry" Then
            FindDuplicateLocal = r
            Exit Function
        End If
    Next r
    
    FindDuplicateLocal = 0
End Function

Private Function FindDuplicateDB(wsTSData As Worksheet, entID As String, engID As String, _
                                 monthName As String, weekName As String, regionName As String, teamName As String) As Long
    Dim r As Long, lastRow As Long
    lastRow = wsTSData.Cells(wsTSData.Rows.count, 1).End(xlUp).Row
    
    For r = 2 To lastRow
        If wsTSData.Cells(r, 2).value = entID And _
           wsTSData.Cells(r, 10).value = engID And _
           wsTSData.Cells(r, 7).value = monthName And _
           wsTSData.Cells(r, 8).value = weekName And _
           wsTSData.Cells(r, 9).value = regionName And _
           wsTSData.Cells(r, 12).value = teamName Then
            FindDuplicateDB = r
            Exit Function
        End If
    Next r
    
    FindDuplicateDB = 0
End Function

Private Function FindDuplicateCode(wsForm As Worksheet, wsTSData As Worksheet, entID As String, engID As String, _
                                   monthName As String, weekName As String, regionName As String, teamName As String) As String
    Dim r As Long, lastRow As Long
    
    ' Check local first
    lastRow = wsForm.Cells(wsForm.Rows.count, "B").End(xlUp).Row
    For r = 3000 To lastRow
        If wsForm.Cells(r, 3).value = entID And _
           wsForm.Cells(r, 10).value = engID And _
           wsForm.Cells(r, 7).value = monthName And _
           wsForm.Cells(r, 8).value = weekName And _
           wsForm.Cells(r, 9).value = regionName And _
           wsForm.Cells(r, 12).value = teamName Then
            FindDuplicateCode = wsForm.Cells(r, 2).value
            Exit Function
        End If
    Next r
    
    ' Check database
    lastRow = wsTSData.Cells(wsTSData.Rows.count, 1).End(xlUp).Row
    For r = 2 To lastRow
        If wsTSData.Cells(r, 2).value = entID And _
           wsTSData.Cells(r, 10).value = engID And _
           wsTSData.Cells(r, 7).value = monthName And _
           wsTSData.Cells(r, 8).value = weekName And _
           wsTSData.Cells(r, 9).value = regionName And _
           wsTSData.Cells(r, 12).value = teamName Then
            FindDuplicateCode = wsTSData.Cells(r, 1).value
            Exit Function
        End If
    Next r
    
    FindDuplicateCode = ""
End Function

