Private Sub Worksheet_Activate()
    ' Set default timesheet type
    If Me.Range("BA2").value = "" Then
        Me.Range("BA2").value = "New Timesheet Entry"
    End If
    
    ' Select Month cell by default
    If Me.Range("W6").value <> "" Then
        Me.Range("C6").Select
    End If
